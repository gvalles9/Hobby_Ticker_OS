#!/bin/bash

# pi-gen configuration for Hobby Ticker OS

IMG_NAME='hobbyticker'

# Use the standard stage list (stage2 contains our custom hobbyticker stage)
STAGE_LIST="stage0 stage1 stage2"

# Disable compression for faster builds (can be re-enabled for production)
DEPLOY_COMPRESSION=xz

# Set hostname
HOSTNAME=hobbyticker

# Enable SSH
ENABLE_SSH=1

# Set first user (pi user with default password)
FIRST_USER_NAME=pi
FIRST_USER_PASS=raspberry

# Set timezone
TIMEZONE=UTC
