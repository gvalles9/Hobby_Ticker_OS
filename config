#!/bin/bash

# pi-gen configuration for Hobby Ticker OS

IMG_NAME='hobbyticker'

# Use standard stages (stage2 contains our custom hobbyticker stage)
STAGE_LIST="stage0 stage1 stage2"

# Deploy compressed images (.img.xz)
DEPLOY_COMPRESSION=xz

# Set hostname
HOSTNAME=hobbyticker

# Disable SSH in the released image. pi-gen still installs openssh-server,
# but with ENABLE_SSH=0 it runs `systemctl disable ssh`, so the image does not
# accept remote logins out of the box. This is a giveaway build.
ENABLE_SSH=0

# Set default user
FIRST_USER_NAME=pi
FIRST_USER_PASS=raspberry

# Set timezone
TIMEZONE=UTC
