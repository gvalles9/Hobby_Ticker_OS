#!/bin/bash

# pi-gen configuration for Hobby Ticker OS

IMG_NAME='hobbyticker'

# Use standard stages followed by custom hobbyticker stage
STAGE_LIST="stage0 stage1 stage2 stage2-hobbyticker"

# Deploy compressed images (.img.xz)
DEPLOY_COMPRESSION=xz

# Set hostname
HOSTNAME=hobbyticker

# Enable SSH
ENABLE_SSH=1

# Set default user
FIRST_USER_NAME=pi
FIRST_USER_PASS=raspberry

# Set timezone
TIMEZONE=UTC
